# ---------------------------------------------------------------
# Phase 0 locked hosting as local-only; these defaults reflect that.
# Copy to backend/.env and fill in. .env is gitignored - never commit it.
# ---------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# ---- Supabase ----
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Backend only.
# Never expose it to the browser or place it in frontend/.env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Anon key is optional here; the frontend needs it to read the
# municipalities registry directly (see PART 7 of the schema).
SUPABASE_ANON_KEY=

# ---- Voyage (embeddings, required from Phase 2) ----
# Free 200M-token grant, no daily cap: https://www.voyageai.com/
VOYAGE_API_KEY=

# ---- Gemini (unused; kept so it can be reinstated) ----
# Free tier, no payment method needed: https://aistudio.google.com/apikey
# NOTE: on the free tier Google may use submitted content to improve its
# products, and human reviewers may read API input/output. That is fine for
# ingesting published bylaws; revisit before user queries are embedded in
# production (Phase 6).
GEMINI_API_KEY=
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIMENSIONS=1024
# Free-tier limits with no payment method on file. Raise if you
# add one (the 200M free tokens still apply either way).
EMBEDDING_REQUESTS_PER_MINUTE=3
EMBEDDING_TOKENS_PER_MINUTE=10000

# Optional: only needed if embeddings are moved back to OpenAI.
OPENAI_API_KEY=

# ---- Groq (generation, required from Phase 3) ----
# Free tier, no payment method needed: https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# ---- Retrieval (keep in step with the RPC defaults in the schema) ----
MATCH_THRESHOLD=0.3
VECTOR_MATCH_COUNT=5
KEYWORD_MATCH_COUNT=5

# ---- Localisation (Phase 0: bilingual from day one) ----
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en","fr"]

# ---- Rate limiting (enforced in Phase 5) ----
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000"]
