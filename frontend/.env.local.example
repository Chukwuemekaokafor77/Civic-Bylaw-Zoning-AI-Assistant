# Copy to frontend/.env.local (gitignored).
#
# The FastAPI backend. Phase 0 locked local-only hosting.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase ANON key only. Row Level Security limits it to `provinces` and
# active `municipalities` (PART 7 of backend/db/001_init_schema.sql), which
# is exactly what RegionalSelector needs.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY here. NEXT_PUBLIC_ variables are
# inlined into the browser bundle; the service-role key bypasses RLS and
# would expose every table, including the query_log of user questions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
